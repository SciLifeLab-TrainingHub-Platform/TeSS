<%= link_to(root_url) do %>
  <%= image_tag(TeSS::Config.site['logo_email'], alt: TeSS::Config.site['title_short'],
                title: "Visit #{TeSS::Config.site['title_short']}",
                style: 'width: 100%;', target: '_blank') %>
<% end %>
<br>
<div style="font-family: Arial, sans-serif; color: #333; line-height: 1.6;">
  <!-- User Greeting -->
  <h3>Hi <strong><%= @course.user.username %></strong>,</h3>

  <!-- Introduction Section -->
  <p style=" margin-top: 20px;">
    Your course has been successfully submitted on the SciLifeLab Training Portal and is
    <strong style="color: #045C64;">currently under review by our team</strong>.
  </p>

  <p style=" margin-top: 20px;">Next Steps:</p>
  <ul style="list-style-type: disc; padding-left: 20px; font-size: 15px; margin-bottom: 20px;">
    <li>If approved, your course will be published and visible on the SciLifeLab Training Portal.</li>
    <li>If any changes are required, you will receive an email from one of our admins with details.</li>
    <li>If the course is declined, you will be notified via email with the reason, and it will be removed from the
      portal.
    </li>
  </ul>

  <!-- Course Details Section -->
  <p>
    Below are the details of your submitted training course:
  </p>
  <ul style="list-style-type: none; padding-left: 0; font-size: 15px; margin-bottom: 20px;">
    <li><strong>Course Title:</strong> <%= @course.title %></li>
    <li><strong>Course URL:</strong>
      <a href="<%= @course.url %>" style="color: #045C64; text-decoration: none;"><%= @course.url %></a>
    </li>
  </ul>

  <p style=" margin-top: 20px;">
    You can view and manage your course using the following link:
    <a href="<%= course_url(@course) %>"
       style="color: #045C64; text-decoration: underline; font-weight: bold;">
      View Course
    </a>.
  </p>
</div>

<% booking_url = "https://cal.com/#{cal_link}" %>
<div class="resources-booking"
     data-cal-embed
     data-cal-namespace="<%= namespace %>"
     data-cal-link="<%= cal_link %>">
  <p class="resources-booking__status"
     data-cal-status
     data-loading-message="<%= t('our_resources.landing.consultation.booking.loading') %>"
     data-failure-message="<%= t('our_resources.landing.consultation.booking.failure') %>"
     role="status"
     aria-live="polite"></p>

  <div class="resources-booking__calendar"
       id="my-cal-inline-<%= namespace %>"
       data-cal-calendar
       hidden></div>

  <p class="resources-booking__fallback">
    <%= link_to t('our_resources.landing.consultation.booking.external'),
                booking_url,
                target: '_blank',
                rel: 'noopener noreferrer' %>
  </p>
</div>

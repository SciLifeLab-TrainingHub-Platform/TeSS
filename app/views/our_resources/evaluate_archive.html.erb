<%= render layout: 'our_resources/stage_pages/shell',
           locals: { stage_key: :evaluate_archive } do %>
  <% prepare_materials = t('our_resources.stage_pages.evaluate_archive.sections.prepare_materials').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= prepare_materials[:anchor] %>">
    <h2><%= prepare_materials[:title] %></h2>
    <div class="resources-stage-section__body resources-stage-prose">
      <p>
        <%= prepare_materials.dig(:metadata, :before_link) %>
        <%= link_to prepare_materials.dig(:metadata, :link_label),
                    prepare_materials.dig(:metadata, :url),
                    target: '_blank',
                    rel: 'noopener noreferrer' %> <%= prepare_materials.dig(:metadata, :after_link) %>
      </p>
      <p><%= prepare_materials[:recordings] %></p>
    </div>

    <div class="resources-stage-section__visual">
      <%= render 'our_resources/stage_pages/visual_links',
                 links: prepare_materials[:visual_links].values,
                 visual_height: 86,
                 max_width: 408,
                 label_width: 173 %>
    </div>
  </section>

  <% archive = t('our_resources.stage_pages.evaluate_archive.sections.archive').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= archive[:anchor] %>">
    <h2><%= archive[:title] %></h2>
    <div class="resources-stage-section__body resources-stage-prose">
      <p>
        <%= archive.dig(:introduction, :before_repository) %>
        <%= link_to archive.dig(:introduction, :repository_label),
                    archive.dig(:introduction, :repository_url),
                    target: '_blank',
                    rel: 'noopener noreferrer' %>
        <%= archive.dig(:introduction, :between_repositories) %>
        <%= link_to archive.dig(:introduction, :zenodo_label),
                    archive.dig(:introduction, :zenodo_url),
                    target: '_blank',
                    rel: 'noopener noreferrer' %>
        <%= archive.dig(:introduction, :after_zenodo) %>
      </p>
    </div>

    <div class="resources-stage-section__visual">
      <%= render 'our_resources/stage_pages/action_panel',
                 columns: archive.dig(:panel, :columns),
                 class_name: 'resources-evaluate__archive-panel' %>
    </div>
  </section>

  <% oer_communities = t('our_resources.stage_pages.evaluate_archive.sections.oer_communities').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= oer_communities[:anchor] %>">
    <h2><%= oer_communities[:title] %></h2>
    <div class="resources-stage-section__body resources-stage-prose">
      <p>
        <%= oer_communities.dig(:introduction, :before_grena) %>
        <%= link_to oer_communities.dig(:introduction, :grena_label),
                    oer_communities.dig(:introduction, :grena_url),
                    target: '_blank',
                    rel: 'noopener noreferrer' %>
        <%= oer_communities.dig(:introduction, :between_grena_and_suhf) %>
        <%= link_to oer_communities.dig(:introduction, :suhf_label),
                    oer_communities.dig(:introduction, :suhf_url),
                    target: '_blank',
                    rel: 'noopener noreferrer' %><%= oer_communities.dig(:introduction, :after_suhf) %>
      </p>
      <p>
        <%= oer_communities.dig(:introduction, :before_tess) %>
        <%= link_to oer_communities.dig(:introduction, :tess_label),
                    oer_communities.dig(:introduction, :tess_url),
                    target: '_blank',
                    rel: 'noopener noreferrer' %> <%= oer_communities.dig(:introduction, :after_tess) %>
      </p>
    </div>

    <div class="resources-stage-section__visual">
      <%= render 'our_resources/stage_pages/visual_links',
                 links: oer_communities[:visual_links].values,
                 visual_height: 80,
                 max_width: 469,
                 label_width: 173,
                 label_gap: 20,
                 margin_top: 52,
                 class_name: 'resources-stage-visual-links--stack-mobile' %>
    </div>
  </section>

  <% reflections = t('our_resources.stage_pages.evaluate_archive.sections.reflections').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= reflections[:anchor] %>">
    <h2><%= reflections[:title] %></h2>
    <div class="resources-stage-section__body resources-stage-prose">
      <% reflections[:paragraphs].each_value do |paragraph| %>
        <p><%= paragraph %></p>
      <% end %>
    </div>
  </section>

  <%= render 'our_resources/stage_pages/stage_footer', stage_key: :evaluate_archive %>
<% end %>

<% content_for :title, raw(t('our_resources.stage_pages.develop.title')) %>

<%= render layout: 'our_resources/stage_pages/shell',
           locals: {
             modifier: 'develop',
             active_key: :develop,
             title: t('our_resources.stage_pages.develop.title'),
             intro_paragraphs: [
               t('our_resources.stage_pages.develop.summary'),
               t('our_resources.stage_pages.develop.introduction')
             ],
             section_links: develop_section_links
           } do %>
  <% announcement = t('our_resources.stage_pages.develop.sections.announcement').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= announcement[:anchor] %>">
    <h2><%= announcement[:title] %></h2>
    <div class="resources-stage-section__body resources-stage-prose">
      <% announcement[:paragraphs].each do |paragraph| %>
        <p><%= paragraph %></p>
      <% end %>
    </div>
  </section>

  <% training_page = t('our_resources.stage_pages.develop.sections.training_page').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= training_page[:anchor] %>">
    <h2><%= training_page[:title] %></h2>
    <div class="resources-stage-section__body resources-stage-prose">
      <% training_page[:paragraphs].each do |paragraph| %>
        <p><%= paragraph %></p>
      <% end %>
    </div>
  </section>

  <% computational_tools = t('our_resources.stage_pages.develop.sections.computational_tools').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= computational_tools[:anchor] %>">
    <h2><%= computational_tools[:title] %></h2>
    <div class="resources-stage-section__body resources-stage-prose">
      <% computational_tools[:paragraphs].each do |paragraph| %>
        <p><%= paragraph %></p>
      <% end %>
    </div>
  </section>

  <% fair_materials = t('our_resources.stage_pages.develop.sections.fair_materials').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= fair_materials[:anchor] %>">
    <h2><%= fair_materials[:title] %></h2>
    <div class="resources-stage-section__body resources-stage-prose">
      <% fair_materials[:paragraphs].each do |paragraph| %>
        <p><%= paragraph %></p>
      <% end %>
    </div>
  </section>
<% end %>

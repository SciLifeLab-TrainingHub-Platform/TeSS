<%= render layout: 'our_resources/stage_pages/shell',
           locals: { stage_key: :deliver } do %>
  <% facilitation = t('our_resources.stage_pages.deliver.sections.facilitation').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= facilitation[:anchor] %>">
    <h2><%= facilitation[:title] %></h2>
    <div class="resources-stage-section__body resources-stage-prose">
      <p><%= facilitation[:introduction] %></p>
      <p><%= facilitation[:recommendations_intro] %></p>
      <ul>
        <% facilitation[:recommendations].each_value do |recommendation| %>
          <li>
            <% if recommendation[:url].present? %>
              <%= recommendation[:before_link] %>
              <%= link_to recommendation[:link_label],
                          recommendation[:url],
                          target: '_blank',
                          rel: 'noopener noreferrer' %><%= recommendation[:after_link] %>
            <% else %>
              <%= recommendation[:text] %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="resources-stage-section__visual">
      <figure class="resources-stage-illustration">
        <%= image_tag asset_path(facilitation.dig(:illustration, :image)),
                      alt: facilitation.dig(:illustration, :alt),
                      class: 'resources-stage-illustration__image',
                      width: 340,
                      height: 219 %>
      </figure>
    </div>
  </section>

  <% tools = t('our_resources.stage_pages.deliver.sections.tools').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= tools[:anchor] %>">
    <h2><%= tools[:title] %></h2>
    <div class="resources-stage-section__body resources-stage-prose">
      <p>
        <%= tools.dig(:introduction, :before_link) %>
        <%= link_to tools.dig(:introduction, :link_label),
                    tools.dig(:introduction, :url),
                    target: '_blank',
                    rel: 'noopener noreferrer' %>
        <%= tools.dig(:introduction, :after_link) %>
      </p>
    </div>

    <div class="resources-stage-section__visual">
      <div class="resources-stage-actions resources-deliver__mentimeter-action-row">
        <%= render 'our_resources/stage_pages/action_link',
                   label: tools.dig(:action, :label),
                   url: tools.dig(:action, :url),
                   variant: 'lime',
                   icon: 'star-o',
                   class_name: 'resources-deliver__mentimeter-action' %>
      </div>
    </div>

    <div class="resources-stage-section__body">
      <div class="resources-stage-prose">
        <p><%= tools[:follow_up] %></p>
      </div>

      <%= render 'our_resources/stage_pages/link_list',
                 links: tools[:links].values,
                 class_name: 'resources-deliver__tool-links' %>
    </div>
  </section>

  <% feedback = t('our_resources.stage_pages.deliver.sections.feedback').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= feedback[:anchor] %>">
    <h2><%= feedback[:title] %></h2>
    <div class="resources-stage-section__body resources-stage-prose">
      <p><%= feedback[:certificate_text] %></p>
      <p>
        <%= feedback.dig(:survey_text, :before_link) %>
        <%= link_to feedback.dig(:survey_text, :link_label),
                    feedback.dig(:survey_text, :url),
                    target: '_blank',
                    rel: 'noopener noreferrer' %><%= feedback.dig(:survey_text, :after_link) %>
      </p>
    </div>

    <div class="resources-stage-section__visual">
      <%= render 'our_resources/stage_pages/visual_links',
                 links: feedback[:visual_links].values %>
    </div>
  </section>

  <%= render 'our_resources/stage_pages/stage_footer', stage_key: :deliver %>
<% end %>

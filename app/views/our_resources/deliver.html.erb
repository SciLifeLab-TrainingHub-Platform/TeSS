<% content_for :title, raw(t('our_resources.stage_pages.deliver.title')) %>

<%= render layout: 'our_resources/stage_pages/shell',
           locals: {
             modifier: 'deliver',
             active_key: :deliver,
             title: t('our_resources.stage_pages.deliver.title'),
             intro_paragraphs: [
               t('our_resources.stage_pages.deliver.summary'),
               t('our_resources.stage_pages.deliver.introduction')
             ],
             section_links: deliver_section_links
           } do %>
  <% facilitation = t('our_resources.stage_pages.deliver.sections.facilitation').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= facilitation[:anchor] %>">
    <h2><%= facilitation[:title] %></h2>
    <div class="resources-stage-section__body resources-stage-prose">
      <p><%= facilitation[:body] %></p>
    </div>
  </section>

  <% tools = t('our_resources.stage_pages.deliver.sections.tools').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= tools[:anchor] %>">
    <h2><%= tools[:title] %></h2>
    <div class="resources-stage-section__body">
      <ul class="resources-stage-deliver__tool-list">
        <% deliver_tools.each do |tool| %>
          <li class="resources-stage-deliver__tool-item">
            <% if tool[:url].present? %>
              <%= link_to tool[:url],
                          class: 'resources-stage-deliver__tool',
                          target: '_blank',
                          rel: 'noopener noreferrer' do %>
                <%= image_tag(asset_path(tool[:image]), alt: '', class: 'resources-stage-deliver__tool-image') %>
                <span class="resources-stage-deliver__tool-title"><%= tool[:title] %></span>
                <% if tool[:description].present? %>
                  <span class="resources-stage-deliver__tool-description"><%= tool[:description] %></span>
                <% end %>
              <% end %>
            <% else %>
              <div class="resources-stage-deliver__tool resources-stage-deliver__tool--static">
                <%= image_tag(asset_path(tool[:image]), alt: '', class: 'resources-stage-deliver__tool-image') %>
                <span class="resources-stage-deliver__tool-title"><%= tool[:title] %></span>
                <% if tool[:description].present? %>
                  <span class="resources-stage-deliver__tool-description"><%= tool[:description] %></span>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <% feedback = t('our_resources.stage_pages.deliver.sections.feedback').with_indifferent_access %>
  <section class="resources-stage-section" id="<%= feedback[:anchor] %>">
    <h2><%= feedback[:title] %></h2>
  </section>

  <%= render 'our_resources/stage_pages/resources',
             title: t('our_resources.stage_pages.deliver.resources_heading'),
             resources: deliver_resources %>

  <%= render 'our_resources/stage_pages/contributors',
             title: t('our_resources.stage_pages.contributors_heading'),
             contributors: deliver_contributors %>
<% end %>

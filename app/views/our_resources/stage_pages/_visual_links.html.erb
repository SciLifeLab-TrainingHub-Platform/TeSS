<% list_classes = ['resources-stage-visual-links'] %>
<% list_classes << local_assigns[:class_name] if local_assigns[:class_name].present? %>
<% visual_height = local_assigns.fetch(:visual_height, 72).to_i %>
<% max_width = local_assigns.fetch(:max_width, 382).to_i %>
<% label_width = local_assigns.fetch(:label_width, 208).to_i %>
<% label_gap = local_assigns.fetch(:label_gap, 7).to_i %>
<% margin_top = local_assigns.fetch(:margin_top, 36).to_i %>

<ul class="<%= list_classes.join(' ') %>"
    style="--resources-stage-visual-height: <%= visual_height %>px;
           --resources-stage-visual-max-width: <%= max_width %>px;
           --resources-stage-visual-label-width: <%= label_width %>px;
           --resources-stage-visual-label-gap: <%= label_gap %>px;
           --resources-stage-visual-margin-top: <%= margin_top %>px;">
  <% links.each do |link| %>
    <li>
      <%= link_to link[:url],
                  class: 'resources-stage-visual-link',
                  **resources_link_options(link[:url]) do %>
        <span class="resources-stage-visual-link__visual">
          <%= image_tag asset_path(link[:image]),
                        alt: '',
                        class: 'resources-stage-visual-link__image',
                        width: link[:image_width],
                        height: link[:image_height] %>
        </span>
        <span class="resources-stage-visual-link__label"><%= link[:label] %></span>
      <% end %>
    </li>
  <% end %>
</ul>

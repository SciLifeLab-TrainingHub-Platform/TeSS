<section class="resources-landing" aria-labelledby="resources-landing-title">
  <header class="resources-landing__intro">
    <h1 id="resources-landing-title"><%= t('our_resources.landing.title') %></h1>
    <p><%= t('our_resources.landing.intro') %></p>
  </header>

  <ol class="resources-lifecycle" aria-label="<%= t('our_resources.landing.lifecycle.label') %>">
    <% resource_lifecycle_stages.each do |stage| %>
      <li class="resources-lifecycle__item">
        <p class="resources-lifecycle__timeframe"><%= stage[:timeframe] %></p>

        <span class="resources-lifecycle__marker" aria-hidden="true"></span>

        <%= link_to stage[:path], class: 'resources-lifecycle__card' do %>
          <h2><%= stage[:title] %></h2>
          <p><%= stage[:description] %></p>
        <% end %>
      </li>
    <% end %>
  </ol>
</section>

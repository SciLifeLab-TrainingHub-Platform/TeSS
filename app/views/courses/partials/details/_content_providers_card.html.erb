<% course = local_assigns.fetch(:course) %>
<% providers = Array(course.content_providers).compact %>

<% if providers.any? %>
  <%= course_section_card(Course.human_attribute_name(:content_providers), class: 'event-section-card--sidebar') do %>
    <div class="event-content-providers">
      <% providers.each do |provider| %>
        <div class="event-content-provider">
          <h4 class="event-content-provider__title"><%= link_to provider.title, provider %></h4>

          <% if provider.description.present? %>
            <div class="event-content-provider__description markdown">
              <%= render_markdown(provider.description) %>
            </div>
          <% end %>

          <% if provider.url.present? %>
            <p class="event-content-provider__link">
              <%= link_to provider.url, provider.url, target: '_blank', rel: 'noopener noreferrer' %>
            </p>
          <% end %>

          <div class="event-content-provider__media">
            <%= link_to provider do %>
              <%= image_tag(get_image_url_for(provider), class: 'event-content-provider__logo', alt: provider.title) %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

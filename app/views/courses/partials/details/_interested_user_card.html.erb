<hr>
<% if user_signed_in? %>

  <div class="py-2">
    <div class="d-flex align-items-center justify-content-between">

      <% if course.subscribed_by?(current_user) %>
        <!-- UNREGISTER STATE -->
        <div class="text-success">
          <span>You are subscribed to notifications for this training.</span>
          <button type="button" class="btn btn-link p-0 text-danger mb-1">
            Unregister interest
          </button>
        </div>
    <% else %>
        <!-- REGISTER STATE -->
        <div class="text-muted">
          <span>Notify me when new sessions are available</span>
          <%= button_to "Register interest",
                        course_interest_path(course),
                        method: :post,
                        class: "btn btn-link p-0 fw-medium mb-1" %>
        </div>
      <% end %>
    </div>
  </div>

<% else %>

  <div class="py-2 m-auto" style="width: 50%; text-align: center;">

    <div class="fw-medium mb-2">
      Manage notifications for this training
    </div>
    <div class="mb-2">
      <input
        type="email"
        class="form-control form-control-sm"
        placeholder="Email address"
      >
    </div>
    <div class="d-flex gap-3">
      <button
        type="button"
        class="btn btn-link p-0 fw-medium text-primary"
      >
        Subscribe
      </button>
      <button
        type="button"
        class="btn btn-link p-0 text-danger"
      >
        Unsubscribe
      </button>

    </div>
  </div>
<% end %>



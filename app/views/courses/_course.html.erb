<% collection_item = local_assigns[:collection_item] %>

<li class="masonry-brick media-item long course-card">
  <%= item_order_badge(collection_item) if collection_item.present? %>

  <div class="course-card__content">
    <% icons = [] %>
    <% if current_user&.is_admin? %>
      <% icons << missing_icon(course) if course.respond_to?(:failing?) %>
      <% icons << scrape_status_icon(course) if course.respond_to?(:last_scraped) %>
    <% end %>
    <% icons << review_status_icon(course) %>
    <%= render partial: 'common/index_card_heading',
               locals: { resource: course, title: course.title, icons: safe_join(icons.compact) } %>

    <% next_event = course_next_event(course) %>
    <div class="course-card__meta-row">
      <% if next_event %>
        <p class="course-card__meta">
          <strong>Next instance:</strong>
          <%= link_to next_event, class: 'course-next-instance-link' do %>
            <span><%= course_event_date_range(next_event) %></span>
            <i class="icon icon-md arrow-top-right"></i>
          <% end %>
        </p>
      <% else %>
        <p class="course-card__meta">
          <strong>No upcoming instances</strong>
        </p>
      <% end %>

      <% if show_scilifelab_badge?(course) %>
        <div class="course-card__badge">
          <%= elixir_node_icon %>
        </div>
      <% end %>
    </div>
  </div>

  <%= item_comment(collection_item) if collection_item.present? %>
</li>

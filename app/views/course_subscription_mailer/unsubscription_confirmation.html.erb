<%= link_to(root_url) do %>
  <%= image_tag(TeSS::Config.site['logo_email'],
                alt: TeSS::Config.site['title_short'],
                title: "Visit #{TeSS::Config.site['title_short']}",
                style: 'width: 100%;',
                target: '_blank') %>
<% end %>

<br>

<div style="font-family: Arial, sans-serif; color: #333; line-height: 1.6;">

  <p>Hello,</p>

  <p>
    You requested to unsubscribe from updates for the following course:
  </p>

  <p>
    <strong><%= @course.title %></strong>
  </p>

  <p>
    To confirm your unsubscription, please click the link below:
  </p>

  <p style="margin: 20px 0;">
    <a
      href="<%= @confirmation_url %>"
      style="
        background-color: #dc2626;
        color: #ffffff;
        padding: 12px 20px;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
        display: inline-block;
        font-family: Arial, sans-serif;
      "
    >
      Confirm Unsubscription
    </a>
  </p>

  <p>
    If you did not request this change, you can safely ignore this email.
  </p>

  <p>
    For security reasons, this confirmation link will expire in <strong><%= @expires_in_days %> days</strong>.
    If it expires, you can request a new confirmation email.
  </p>

  <p>
    Best regards,<br>
    The Training Hub Team
  </p>

</div>
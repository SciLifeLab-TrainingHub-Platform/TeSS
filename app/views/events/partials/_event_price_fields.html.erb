<div class="nested-fields price-fields mb-2 border">
  <%= f.hidden_field :_destroy %>

  <div class="row m-4">
    <div class="col-sm-4 mb-2 form-group <%= 'has-error' if f.object.errors[:cost].any? %>">
      <%= f.number_field :cost, value: 0, class: "form-control", placeholder: "Cost" %>
      <small class="form-text text-muted">Enter the cost in your preferred currency.</small>
      <% if f.object.errors[:cost].any? %>
        <span class="help-block">
          <%= f.object.errors[:cost].join(", ") %>
        </span>
      <% end %>
    </div>

    <div class="col-sm-4 mb-2">
      <%= f.select :currency,
                   options_for_select(currency_collection, f.object.currency || "SEK"),
                   {},
                   class: "form-control"
      %>
      <small class="form-text text-muted">Select the currency for this cost.</small>
    </div>

    <div class="col-sm-3">
      <%= f.select :audience_type,
                   get_event_audience_types(current_user),
                   {},
                   class: "form-control js-select2-tags"
      %>
      <small class="form-text text-muted">
        Choose an audience type or type a new one to add it.
      </small>
    </div>

    <div class="col-sm-1 mb-2">
      <%= link_to_remove_association(f, class: "btn btn-link btn-xs mx-0 px-0 remove-btn") do %>
        <!-- Mobile remove -->
        <span class="glyphicon glyphicon-remove text-danger hidden-xs"></span>
        <!-- Desktop remove -->
        <span class="btn btn-danger btn-block btn-xs visible-xs-block">Remove</span>
      <% end %>
    </div>
  </div>
</div>

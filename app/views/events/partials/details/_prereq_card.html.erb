<% event = local_assigns.fetch(:event) %>

<% if event.prerequisites.present? || event.tech_requirements.present? %>
  <%= event_section_card('Prerequisites & Technical Requirements', class: 'event-section-card--full') do %>
    <% if event.prerequisites.present? %>
      <div class="event-rich-text markdown event-prereq__section">
        <h4 class="event-overview__heading event-prereq__heading">Prerequisites</h4>
        <%= render_markdown(event.prerequisites) %>
      </div>
    <% end %>

    <% if event.tech_requirements.present? %>
      <% if event.prerequisites.present? %>
        <hr class="event-prereq__divider">
      <% end %>
      <div class="event-rich-text markdown event-prereq__section">
        <h4 class="event-overview__heading event-prereq__heading">Technical requirements</h4>
        <%= render_markdown(event.tech_requirements) %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%- model_class = Event -%>
<div class="page-header">
  <%= page_title("New Course Announcement") %>
</div>
<div class="row">
  <div class="col-md-4 col-md-push-8">
    <%= render :partial => "events/partials/general_event_info" %>
  </div>
  <div class="col-md-8 col-md-pull-4">
    <% if @prefill_course && @prefill_applied_fields.present? %>
      <div class="alert alert-info alert-dismissible fade in" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
        <strong>Prefilled from "<%= @prefill_course.title %>".</strong>
        <div>
          <%= pluralize(@prefill_applied_fields.length, 'field') %> prefilled:
          <%= @prefill_applied_fields.map { |f| humanize_prefill_field(f) }.join(', ') %>.
          Please review and set dates, venue, and URL.
        </div>
      </div>
    <% end %>

    <% if @prefill_warnings.present? %>
      <div class="alert alert-warning alert-dismissible fade in" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
        <ul class="list-unstyled mb-0">
          <% @prefill_warnings.each do |warning| %>
            <li><%= warning %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= render :partial => 'form' %>
  </div>
</div>

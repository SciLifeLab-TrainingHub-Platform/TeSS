<%= simple_form_for @event, html: { id: 'event_form', class: 'prevent-enter-submit' } do |f| %>

  <%= render partial: 'common/error_summary', locals: { resource: @event } %>

  <!-- Field: Disabled -->
  <%= f.input :visible, label: 'Show this event?', input_html: { title: t('events.hints.visible') } %>

  <!-- Field: presence -->
  <div class="form-group">
    <%= label_tag('type') %> <br/>
    <div class="btn-group" data-toggle="buttons">
      <% [:onsite, :hybrid, :online].each do |presence| %>
        <% active = @event.send("#{presence}?") %>
        <label class="btn btn-lg btn-secondary <%= 'active' if active %>">
          <%= f.radio_button 'online', presence, class: 'location', data: { role: 'online-switch' },
                             checked: active, autocomplete: 'off' %>
          <i class="icon icon-lg <%= presence %>-event-icon"></i> <%= t("activerecord.attributes.event.presence.#{presence}") %>
        </label>
      <% end %>
    </div>
  </div>

  <!-- Field: Title -->
  <div class="form-group">
    <%= f.label :title, class: "control-label" %>
    <span class="glyphicon" style="cursor: default; font-size: small" title="<%= t('events.hints.title_hint') %>">&#xe086;</span>
    <%= f.input :title, as: :string, input_html: { title: t('events.hints.title') }, label: false %>
  </div>


  <!-- Field: Sub-title -->
  <%#= f.input :subtitle, input_html: { title: t('events.hints.subtitle') } %>

  <!-- Field: URL -->
  <%= render partial: 'common/url_checker',
             locals: { f: f, url: events_check_exists_path, title: t('events.hints.url') } %>

  <!-- Field: Start -->
  <%= f.input :start, as: :date_picker, input_html: { title: t('events.hints.start') } %>

  <!-- Field: End -->
  <%= f.input :end, as: :date_picker, input_html: { title: t('events.hints.end') } %>

  <!-- Field: Application deadline -->
  <%= f.input :application_deadline, as: :datetime_picker, input_html: { title: t('events.hints.application_deadline') } %>

  <!-- Field: registration_form_url -->
  <%= f.label :registration_form_url, class: "control-label", label: 'Registration form URL' %>
  <span class="glyphicon" style="cursor: default; font-size: small" title="<%= t('events.hints.registration_form_url_hint') %>">&#xe086;</span>
  <%=
    f.input :registration_form_url,
            input_html: {
              type: 'url',
              title: t('events.hints.registration_form_url')
            },
            label: false
  %>

  <!-- Field: Timezone -->
  <%= f.input :timezone, as: :time_zone, priority: priority_time_zones,
              input_html: { class: 'js-select2', title: t('events.hints.timezone') } %>

  <!-- Field: Duration -->
  <%#= f.input :duration, as: :string, input_html: { title: t('events.hints.duration') } %>

  <!-- Field: Language -->
  <%= f.input :language, collection: LanguageDictionary.instance.options_for_select,
              prompt: t('events.prompts.language'), include_blank: true, input_html: { title: t('events.hints.language') } %>

  <!-- Field: Contact -->
  <%= f.label :contact, class: "control-label" %>
  <span class="glyphicon" style="cursor: default; font-size: small" title="<%= t('events.hints.contact_hint') %>">&#xe086;</span>
  <%= f.input :contact, input_html: { rows: '5', title: t('events.hints.contact') }, label: false %>

  <!-- Field: Description -->
  <%= f.label :description, class: "control-label" %>
  <span class="glyphicon" style="cursor: default; font-size: small" title="<%= t('events.hints.description_hint') %>">&#xe086;</span>
  <%= f.input :description, as: :markdown_area, input_html: { rows: '5', title: t('events.hints.description') }, label: false %>

  <!-- Field: Target Audience -->
  <%= f.multi_input :target_audience,
                    errors: @event.errors[:target_audience],
                    title: t('events.hints.targets'),
                    label: "#{f.label(:target_audience, class: 'control-label')} <span class='glyphicon' style='cursor: default; font-size: small' title='#{t('events.hints.targets_hint')}'> &#xe086;</span>".html_safe %>

  <!-- Field: Prerequisites -->
  <%= f.label :prerequisites, class: "control-label" %>
  <span class="glyphicon" style="cursor: default; font-size: small" title="<%= t('events.hints.prerequisites_hint') %>">&#xe086;</span>
  <%= f.input :prerequisites, as: :markdown_area, input_html: { rows: '3', title: t('events.hints.prerequisites') }, label: false %>

  <!-- Field: Learning Objectives-->
  <!-- Changed the display value to 'Learning outcomes' -->
  <%= f.label :learning_objectives, "* Learning outcomes", class: "control-label" %>
  <span class="glyphicon" style="cursor: default; font-size: small" title="<%= t('events.hints.objectives_hint') %>">&#xe086;</span>
  <%= f.input :learning_objectives, as: :markdown_area, input_html: { rows: '3', title: t('events.hints.objectives') }, label: false %>


  <!-- Field: Keywords -->
  <%= f.multi_input :keywords, errors: @event.errors[:keywords],
                    title: t('events.hints.keywords'),
                    label: "#{f.label(:keywords, class: 'control-label')} <span class='glyphicon' style='cursor: default; font-size: small' title='#{t('events.hints.keywords_hint')}'> &#xe086;</span>".html_safe %>


  <!-- Field: Technology Requirements -->
  <%= f.label :tech_requirements, class: "control-label" %>
  <span class="glyphicon" style="cursor: default; font-size: small" title="<%= t('events.hints.requirements_hint') %>">&#xe086;</span>
  <%= f.input :tech_requirements, as: :markdown_area, input_html: { rows: '3', title: t('events.hints.requirements') }, label: false %>

  <!-- Field: Location -->
  <div class="address_content">
    <%= render partial: 'events/partials/address_finder', locals: { f: f } %>
  </div>

  <!-- Field: Eligibility -->
  <%#= f.dropdown :eligibility,
                 options: EligibilityDictionary.instance.options_for_select,
                 label: 'Eligibility',
                 errors: @event.errors[:eligibility],
                 title: t('events.hints.eligibility') %>


  <!-- Field: Host Institutions -->
  <%#= f.multi_input :host_institutions, errors: @event.errors[:host_institutions], title: t('events.hints.hosts') %>


  <!-- Field: Fields -->
  <% if !TeSS::Config.feature['disabled'].include? 'ardc_fields_of_research' %>
    <%= render partial: 'common/ardc_vocab_tree',
               locals: { f: f,
                         resource: @event,
                         field_name: 'fields',
                         field_label: 'Fields of Research',
                         button_label: 'FoR Codes',
                         title: t('events.hints.fields') } %>
  <% end %>



  <!-- Field: Scientific Topics -->
  <%# if !TeSS::Config.feature['disabled'].include? 'topics' %>
  <%#= f.autocompleter :scientific_topics, url: edam_topics_path, template: 'autocompleter/term', label: 'Topics', id_field: :uri, label_field: :preferred_label, input_html: { title: t('events.hints.topics') } %>
  <%# end %>

  <!-- Field: Topics -->
  <div class="field">
    <%= f.label :topic_ids, "Topic(s)", class: 'control-label' %>
    <span class="glyphicon" style="cursor: default; font-size: small" title="<%= t('events.hints.topics_hint') %>">&#xe086;</span>
    <%= f.collection_select :topic_ids, @topics, :id, :name, { include_blank: false }, { class: 'js-select2', style: 'width: 100%;', multiple: true, title: t('events.hints.topics') } do |topic| %>
      <option value="<%= topic.id %>" <%= 'selected="selected"' if @selected_topics_ids.include?(topic.id) %>>
        <%= topic.name %>
      </option>
    <% end %>
    <span class="help-block small">Choose one or more Topics for the event.</span>
  </div>


  <!-- Operations: check disabled -->
  <%# if !TeSS::Config.feature['disabled'].include? 'operations' %>
  <%#= f.autocompleter :operations, url: edam_operations_path, template: 'autocompleter/term',
                        id_field: :uri, label_field: :preferred_label %>
  <%# end %>

  <!-- Field: Capacity -->
  <%#= f.input :capacity, as: :integer, input_html: { title: t('events.hints.capacity'), min: '0' } %>

  <!-- Field: Event Type -->
  <%#= f.dropdown :event_types, options: EventTypeDictionary.instance.options_for_select, label: 'Event type', errors: @event.errors[:event_types], title: t('events.hints.event_type') %>


  <!-- Field: Credit or Recognition -->
  <%#= f.input :recognition, as: :string, label: 'Credit or Recognition of Attendance',
              input_html: { title: t('events.hints.recognition') } %>

  <!-- Field: External Resources -->
  <%#= render partial: 'events/partials/external_resources', locals: { f: f } %>

  <!-- Field: Costs -->
  <div class="form-group">
    <%= f.input :cost_basis, collection: CostBasisDictionary.instance.options_for_select,
                prompt: 'Select a cost basis...', input_html: { title: t('events.hints.cost_basis') } %>
    <%= f.input :cost_currency, collection: currency_collection, value_method: :second,
                prompt: 'Select the currency...', input_html: { title: t('events.hints.cost_currency') } %>
    <%= f.input :cost_value, as: :decimal, label: 'Cost', input_html: { title: t('events.hints.cost_value'), min: '0' } %>
  </div>

  <!-- Field: Content Providers -->
  <%#= f.input :content_provider_id, label: 'Content provider (Training Organizer)', collection: current_user.get_editable_providers, label_method: :title, value_method: :id, include_blank: true %>
  <div class="field">
    <%= f.label :content_provider_ids, "* Content Provider(s)", class: "control-label" %>
    <span class="glyphicon"
          style="cursor: default; font-size: small;"
          title="<%= t('events.hints.content_provider_hint') %>">
    &#xe086;
  </span>
    <%= f.collection_select :content_provider_ids, @content_providers, :id, :title,
                            { include_blank: false },
                            { class: "js-select2", style: "width: 100%;", multiple: true } do |content_provider| %>
      <option value="<%= content_provider.id %>"
              <%= 'selected="selected"' if @selected_content_providers_id.include?(content_provider.id) %>>
        <%= content_provider.title %>
      </option>
    <% end %>
    <% if @event.errors[:content_providers].present? %>
    <span class="help-block small" style="color: #a02622;">
      <%= @event.errors[:content_providers].join(', ') %>
    </span>
    <% else %>
      <span class="help-block small">Choose one or more content provider for the event.</span>
    <% end %>
  </div>

  <!-- Field: Materials -->
  <%#= f.autocompleter :materials, input_html: { title: t('events.hints.materials') }, url: materials_path %>

  <!-- Fields: that need to be check for enabled/disabled -->

  <%= f.association :course, collection: Course.all, prompt: "Select a course" %>

  <!-- Nodes: check feature enabled -->
  <% if TeSS::Config.feature['nodes'] and Node.all.count > 0 %>
    <div class="form-group">
      <label>* My course is affiliated with SciLifeLab: </label>

      <% Node.order(:name).each do |node| %>
        <div>
          <%= f.radio_button :node_ids, node.id, checked: (@event.node_ids.include?(node.id)) %>
          <%= f.label :node_ids, (node.slug == Node::SCILIFE_LAB_NODE_SLUG ? "Yes" : "No"), value: node.id %>
        </div>
      <% end %>
      <% if @event.errors[:node_ids].any? %>
        <span style="color: #a02622"><%= @event.errors[:node_ids].join(", ") %></span>
      <% end %>
    </div>
  <% end %>

  <!-- Sponsors: check disabled -->
  <%# if !TeSS::Config.feature['disabled'].include? 'sponsors' %>
  <%#= f.multi_input :sponsors, errors: @event.errors[:sponsors], hint: t('events.hints.sponsors') %>
  <%# end %>

  <% if @event.event_status == Event.event_statuses.key(Event.event_statuses[:revisions_required]) %>
    <p>After updating this event, an email will be sent to the admin to review and approve the changes.</p>
  <% end %>

  <div class="form-group">
    <%= f.submit (f.object.new_record? ? "Add" : "Update") + " event", :class => 'btn btn-primary' %>
    <%= link_to 'Back', :back, class: 'btn btn-default' %>
    <%= link_to t('.cancel', :default => t("helpers.links.cancel")),
                :back, :class => 'btn btn-default' %>
  </div>
<% end %>

<div id="external-resource-template" style="display: none">
  <%= render partial: 'common/external_resource_form',
             locals: { form_name: 'event', external_resource: ExternalResource.new } %>
</div>

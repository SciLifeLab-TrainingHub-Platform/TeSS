<% resource = local_assigns.fetch(:resource) %>
<% title = local_assigns[:title].presence || resource.try(:title) %>
<% link_class = local_assigns[:link_class].presence || 'course-card__stretched-link' %>
<% icons = local_assigns[:icons] %>

<div class="course-card__heading">
  <h4 class="course-card__title">
    <%= link_to resource, class: link_class do %>
      <span class="course-card__title-text"><%= title %></span>
    <% end %>
  </h4>

  <div class="course-card__icons">
    <%= icons %>
  </div>
</div>

<% opts = {} %>
<% opts['data-url-check'] = url if f.object.new_record? %>
<% opts['data-url-valid'] = test_url_path %>
<% opts['title'] = title unless title.nil? %>
<% opts['placeholder'] = title unless title.nil? %>

<div class="form-group">
  <%= f.label :url, class: "control-label" %>
  <span class="glyphicon" style="cursor: default; font-size: small" title="<%= t('events.hints.url_hint') %>">&#xe086;</span>
  <%= f.input :url, as: :string, hint: ' ', input_html: opts, label: false %>
</div>

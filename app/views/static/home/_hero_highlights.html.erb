<div class="homepage-hero__highlights">
  <% if featured_event %>
    <%= link_to featured_event, class: 'homepage-hero__featured' do %>
      <span class="homepage-hero__featured-label"><%= t('homepage.hero.featured_label') %></span>
      <strong class="homepage-hero__featured-title"><%= featured_event.title %></strong>
      <span class="homepage-hero__featured-meta">
        <span><%= homepage_event_date_range(featured_event) %></span>
        <% if (location = homepage_event_location(featured_event)).present? %>
          <span><%= location %></span>
        <% end %>
      </span>
      <span class="homepage-hero__arrow" aria-hidden="true">
        <%= image_tag 'scilifelab/homepage/arrow-right-circle.svg', alt: '' %>
      </span>
    <% end %>
  <% else %>
    <div class="homepage-hero__featured">
      <span class="homepage-hero__featured-label"><%= t('homepage.hero.featured_label') %></span>
      <strong class="homepage-hero__featured-title"><%= t('homepage.hero.featured_empty') %></strong>
    </div>
  <% end %>

  <div class="homepage-hero__statistics">
    <%= link_to content_providers_path, class: 'homepage-hero__statistic homepage-hero__statistic--providers' do %>
      <strong class="homepage-hero__statistic-value"><%= number_with_delimiter(provider_count) %></strong>
      <span class="homepage-hero__statistic-description">
        <%= t('homepage.hero.statistics.providers.description') %>
      </span>
      <span class="homepage-hero__arrow" aria-hidden="true">
        <%= image_tag 'scilifelab/homepage/arrow-right-circle.svg', alt: '' %>
      </span>
    <% end %>

    <div class="homepage-hero__statistic homepage-hero__statistic--participants">
      <strong class="homepage-hero__statistic-value">
        <%= t('homepage.hero.statistics.participants.value') %>
      </strong>
      <span class="homepage-hero__statistic-description">
        <%= t('homepage.hero.statistics.participants.description') %>
      </span>
    </div>
  </div>
</div>

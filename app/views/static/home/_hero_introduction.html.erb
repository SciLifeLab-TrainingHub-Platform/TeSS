<% popular_searches = t('homepage.hero.popular_searches') %>

<div class="homepage-hero__introduction">
  <h1 id="homepage-hero-title" class="homepage-hero__title">
    <%= t('homepage.hero.headline_html') %>
  </h1>

  <p class="homepage-hero__summary"><%= t('homepage.hero.introduction') %></p>

  <%= form_tag search_path, method: :get, role: 'search', class: 'homepage-hero__search' do %>
    <%= label_tag 'homepage-search', t('homepage.hero.search_label'), class: 'sr-only' %>
    <%= text_field_tag :q,
                       nil,
                       id: 'homepage-search',
                       class: 'homepage-hero__search-field',
                       placeholder: t('homepage.hero.search_placeholder') %>
    <%= button_tag type: 'submit',
                   name: nil,
                   class: 'homepage-hero__search-button',
                   aria: { label: t('homepage.hero.search_label') } do %>
      <%= image_tag 'scilifelab/homepage/search.svg', alt: '', aria: { hidden: true } %>
    <% end %>
  <% end %>

  <div class="homepage-hero__popular">
    <span class="homepage-hero__popular-label"><%= t('homepage.hero.popular_label') %></span>
    <ul class="homepage-hero__popular-list">
      <% popular_searches.each do |search| %>
        <li>
          <%= link_to search[:label], search_path(q: search[:query]), class: 'homepage-hero__popular-link' %>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<section class="homepage-training" aria-labelledby="homepage-training-title">
  <div class="homepage-training__inner">
    <h2 id="homepage-training-title" class="homepage-training__title">
      <%= t('homepage.upcoming_training.title') %>
    </h2>

    <% if @upcoming_training_events.present? %>
      <div class="homepage-training__grid">
        <%= render partial: 'static/home/training_card',
                   collection: @upcoming_training_events,
                   as: :event %>
      </div>
    <% else %>
      <p class="homepage-training__empty"><%= t('homepage.upcoming_training.empty') %></p>
    <% end %>

    <%= render 'static/home/action_button',
               label: t('homepage.upcoming_training.view_all'),
               url: events_path,
               variant: 'aqua',
               icon: 'star-outline',
               class_name: 'homepage-training__view-all' %>
  </div>
</section>

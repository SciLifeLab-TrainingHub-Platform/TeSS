<section class="resources-landing" aria-labelledby="resources-landing-title">
  <header class="resources-landing__intro">
    <h1 id="resources-landing-title"><%= t('resources.landing.title') %></h1>
    <p><%= t('resources.landing.intro') %></p>
  </header>

  <ol class="resources-lifecycle" aria-label="<%= t('resources.landing.lifecycle.label') %>">
    <% resource_lifecycle_stages.each do |stage| %>
      <li class="resources-lifecycle__item">
        <p class="resources-lifecycle__timeframe"><%= stage[:timeframe] %></p>

        <span class="resources-lifecycle__marker" aria-hidden="true"></span>

        <%= link_to stage[:path], class: 'resources-lifecycle__card' do %>
          <h2><%= stage[:title] %></h2>
          <p><%= stage[:description] %></p>
        <% end %>
      </li>
    <% end %>
  </ol>

  <section class="resources-consultation" aria-labelledby="resources-consultation-title">
    <div class="resources-consultation__copy">
      <h2 id="resources-consultation-title"><%= t('resources.landing.consultation.title') %></h2>
      <p><%= t('resources.landing.consultation.paragraphs.introduction') %></p>
      <p><%= t('resources.landing.consultation.paragraphs.support') %></p>
    </div>

    <%= render 'resources/booking_embed',
               namespace: 'support-consult',
               cal_link: 'scilifelab-traininghub/support-consult' %>
  </section>
</section>

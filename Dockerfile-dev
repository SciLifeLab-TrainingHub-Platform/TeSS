ARG RUBY_VERSION=3.3.8
FROM ruby:$RUBY_VERSION-slim AS base

# Install essential dependencies
RUN apt-get update && apt-get install -y \
  build-essential \
  curl \
  file \
  git \
  gnupg2 \
  imagemagick \
  libpq-dev \
  nodejs npm \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install yarn to manage JS dependencies
RUN npm install --global yarn@1.22.22

# Install supercronic (cron alternative) - before app copy so this layer is cached
ENV SUPERCRONIC_URL=https://github.com/aptible/supercronic/releases/download/v0.1.12/supercronic-linux-amd64 \
    SUPERCRONIC=supercronic-linux-amd64 \
    SUPERCRONIC_SHA1SUM=048b95b48b708983effb2e5c935a1ef8483d9e3e
RUN curl -fsSLO "$SUPERCRONIC_URL" \
  && echo "${SUPERCRONIC_SHA1SUM}  ${SUPERCRONIC}" | sha1sum -c - \
  && chmod +x "$SUPERCRONIC" \
  && mv "$SUPERCRONIC" "/usr/local/bin/${SUPERCRONIC}" \
  && ln -s "/usr/local/bin/${SUPERCRONIC}" /usr/local/bin/supercronic

# Create non-root user and set up /code
RUN mkdir -p /code \
  && useradd -m -u 1001 -U -s /bin/sh -d /code appuser \
  && chown -R appuser:appuser /code

USER appuser
WORKDIR /code

# Copy dependency manifests first so bundle/yarn layers are cached when only app code changes
COPY Gemfile Gemfile.lock ./
RUN bundle check || bundle install

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --non-interactive

# Copy application code last (most frequently changed)
COPY . .

# Switch to root only for writing revision and fixing ownership
USER root
RUN if [ -n "$SOURCE_COMMIT" ]; then echo "$SOURCE_COMMIT" > config/.git-revision; fi \
  && chown -R appuser:appuser /code
USER appuser

ENTRYPOINT ["docker/entrypoint.sh"]
EXPOSE 3000

# Development stage
FROM base AS development
CMD bundle exec rails server -b 0.0.0.0

# Production stage
FROM base AS production
USER appuser

# Same order as base: dependency manifests first, then code last (for cache)
COPY Gemfile Gemfile.lock ./
RUN bundle check || bundle install

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --non-interactive

COPY . .

USER root
RUN mkdir -p /code/public/assets \
  && touch /code/tess.crontab \
  && chown -R appuser:appuser /code
USER appuser

RUN bundle exec rake assets:precompile

CMD bundle exec whenever > /code/tess.crontab \
  && (supercronic /code/tess.crontab &) \
  && bundle exec rails server -b 0.0.0.0

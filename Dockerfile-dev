ARG RUBY_VERSION=3.2.5

FROM ruby:$RUBY_VERSION-slim AS base

# nodejs: execjs is loaded at boot
RUN apt-get update && apt-get install -y --no-install-recommends \
  curl \
  file \
  imagemagick \
  libmagickcore-6.q16-6-extra \
  libpq5 \
  nodejs \
  && rm -rf /var/lib/apt/lists/*

ENV SUPERCRONIC_URL=https://github.com/aptible/supercronic/releases/download/v0.1.12/supercronic-linux-amd64 \
    SUPERCRONIC=supercronic-linux-amd64 \
    SUPERCRONIC_SHA1SUM=048b95b48b708983effb2e5c935a1ef8483d9e3e

RUN curl -fsSLO "$SUPERCRONIC_URL" \
 && echo "${SUPERCRONIC_SHA1SUM}  ${SUPERCRONIC}" | sha1sum -c - \
 && chmod +x "$SUPERCRONIC" \
 && mv "$SUPERCRONIC" "/usr/local/bin/${SUPERCRONIC}" \
 && ln -s "/usr/local/bin/${SUPERCRONIC}" /usr/local/bin/supercronic

RUN useradd -m -u 1001 -U -s /bin/sh -d /code appuser

WORKDIR /code

# Bundler 4 rewrites Gemfile.lock unless frozen
ENV BUNDLE_FROZEN=true

ENTRYPOINT ["docker/entrypoint.sh"]

EXPOSE 3000


FROM base AS build-tools

RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential \
  git \
  libpq-dev \
  npm \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global yarn@1.22.22

USER appuser


FROM build-tools AS build-dev

COPY --chown=appuser:appuser Gemfile Gemfile.lock ./
RUN bundle install \
 && rm -rf /usr/local/bundle/cache /usr/local/bundle/bundler/gems/*/.git

COPY --chown=appuser:appuser package.json yarn.lock ./
RUN yarn install --frozen-lockfile --non-interactive && yarn cache clean


FROM build-tools AS build-prod

ENV BUNDLE_DEPLOYMENT=1 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT="development test"

COPY --chown=appuser:appuser Gemfile Gemfile.lock ./
RUN bundle install \
 && rm -rf /usr/local/bundle/ruby/*/cache /usr/local/bundle/ruby/*/bundler/gems/*/.git ~/.bundle

COPY --chown=appuser:appuser package.json yarn.lock ./
RUN yarn install --frozen-lockfile --non-interactive && yarn cache clean

COPY --chown=appuser:appuser . .

# Throwaway key: Rails 7.0 has no SECRET_KEY_BASE_DUMMY
RUN RAILS_ENV=production SECRET_KEY_BASE=precompile-only bundle exec rake assets:precompile \
 && rm -rf node_modules tmp/cache \
 && mkdir -p log tmp/pids


FROM base AS development

COPY --from=build-dev /usr/local/bundle /usr/local/bundle
COPY --from=build-dev --chown=appuser:appuser /code/node_modules ./node_modules
COPY --chown=appuser:appuser . .

USER appuser

CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0"]


FROM base AS production

ENV BUNDLE_DEPLOYMENT=1 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT="development test"

COPY --from=build-prod /usr/local/bundle /usr/local/bundle
COPY --from=build-prod --chown=appuser:appuser /code /code

USER appuser

# exec: puma becomes PID 1 and gets SIGTERM
CMD ["/bin/sh", "-c", "bundle exec whenever > /code/tess.crontab && (supercronic /code/tess.crontab &) && exec bundle exec rails server -b 0.0.0.0"]

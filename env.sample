# Docker
PREFIX=tess

# Rails
SECRET_KEY_BASE=changeme

# Database (db is the docker container name)
DB_HOST=db
DB_NAME=tess
DB_USER=tess
DB_PASSWORD=password

# Seed Admin User
ADMIN_EMAIL=admin@localhost
ADMIN_USERNAME=admin_user
ADMIN_PASSWORD=changeme!

# SOLR (solr is the docker container name)
SOLR_URL=http://solr:8983/solr/tess

# REDIS (redis is the docker container name)
REDIS_URL=redis://redis:6379/1
REDIS_TEST_URL=redis://redis:6379/0

# Outbound mail (consumed by config/secrets.example.yml for production SMTP).
# In Codespaces previews these are overridden by config/secrets.preview.yml,
# which points the mailer at the MailHog sidecar instead.
SMTP_ADDRESS=smtp.example.com
SMTP_DOMAIN=example.com

# Public-facing host(s) — NOT read by the Rails app, kept here for ops/k8s
# reference only. The Kubernetes manifests inject these as the
# RAILS_DEVELOPMENT_HOSTS / equivalent env var on the deployment. Uncomment and
# replace with your environment's actual hostnames if your tooling reads them.
# RAILS_DEVELOPMENT_HOST=your-dev-host.example.com
# RAILS_PRODUCTION_HOST=https://your-prod-host.example.com

# Slack bot token (leave as placeholder unless you have a real test-bot token).
# When the placeholder is used, SlackNotificationJob will log an API error in
# its rescue block and the rest of the app continues to work normally.
SLACK_BOT_USER_OAUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# use comma-separated values if more than 1 channel is needed
SLACK_COURSE_NOTIFICATION_CHANNELS="#channel1,#channel2"

# Google reCAPTCHA — register at https://www.google.com/recaptcha/admin
# Leave as 'changeme' to disable; replace with your test/prod keys to enable.
RECAPTCHA_SITE_KEY=changeme
RECAPTCHA_SECRET_KEY=changeme

# Deployment environment: can be one of 'dev', 'preprod', or 'live'
DEPLOYMENT_ENV=dev

# Matomo Analytics — only active when DEPLOYMENT_ENV=live AND values are set.
# Get these from your Matomo instance.
MATOMO_URL=https://your-matomo-instance.example.com/
MATOMO_SITE_ID=1

# Docker
PREFIX=tess

# Rails
SECRET_KEY_BASE=changeme

# Database (db is the docker container name)
DB_HOST=db
DB_NAME=tess
DB_USER=tess
DB_PASSWORD=password

# Seed Admin User
ADMIN_EMAIL=admin@localhost
ADMIN_USERNAME=admin_user
ADMIN_PASSWORD=changeme!

# SOLR (solr is the docker container name)
SOLR_URL=http://solr:8983/solr/tess

# REDIS (redis is the docker container name)
REDIS_URL=redis://redis:6379/1
REDIS_TEST_URL=redis://redis:6379/0

# slack bot token
SLACK_BOT_USER_OAUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# use comma-separated values if more than 1 channel is needed
SLACK_COURSE_NOTIFICATION_CHANNELS="#channel1,#channel2"

# Deployment environment: can be one of 'dev', 'preprod', or 'live'
DEPLOYMENT_ENV=dev

# Matomo Analytics
# Get these values from your Matomo instance
MATOMO_URL=https://your-matomo-instance.com/
MATOMO_SITE_ID=1

# Local email testing (Mailpit)
# Set MAILPIT_ENABLED=true to route all development mail to the Mailpit container
# and view it at http://localhost:8025. MAILPIT_HOST defaults to the docker
# service name 'mailpit'; set it to 'localhost' for a native (non-docker) setup.
MAILPIT_ENABLED=false
MAILPIT_HOST=mailpit
